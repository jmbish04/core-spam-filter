---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/lib/config";
import { StatsRow } from "@/components/StatsRow";
import { HighAlertFeed } from "@/components/HighAlertFeed";

// Fetch data from API
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:4321';

let stats = { total: 0, spam_count: 0, alert_count: 0 };
let alerts = [];

try {
  const [statsRes, alertsRes] = await Promise.all([
    fetch(`${API_URL}/api/stats`),
    fetch(`${API_URL}/api/emails/alerts`)
  ]);

  if (statsRes.ok) stats = await statsRes.json();
  if (alertsRes.ok) alerts = await alertsRes.json();
} catch (e) {
  console.error("Error fetching dashboard data", e);
}

---

<BaseLayout
  title={siteConfig.name}
  description={siteConfig.description}
>
  <div class="container py-8 space-y-8">
    <h1 class="text-3xl font-bold">Admin Dashboard</h1>
    <StatsRow stats={stats} client:load />
    <div class="grid grid-cols-1 gap-8">
       <HighAlertFeed alerts={alerts} client:load />
    </div>
  </div>
</BaseLayout>
