---
// src/frontend/components/HeadSEO.astro
import "@/styles/global.css";
import { siteConfig } from "@/lib/config";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  type?: "website" | "article";
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  ogImage,
  type = "website",
} = Astro.props as Props;

/** * Safety Check: Use Astro.site if defined, otherwise fallback to config URL.
 * This prevents the "Invalid URL string" TypeError.
 */
const siteBase = Astro.site ? Astro.site.toString() : siteConfig.url;

const canonicalURL = new URL(Astro.url.pathname, siteBase).toString();
const ogImageURL = ogImage
  ? new URL(ogImage, siteBase).toString()
  : new URL("og-image.png", canonicalURL).toString();
const faviconURL = new URL("favicon.svg", canonicalURL).toString();
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content="index, follow" />

<link rel="canonical" href={canonicalURL} />
<link rel="icon" href={faviconURL} type="image/svg+xml" />

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
