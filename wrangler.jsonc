{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "core-spam-filter",
  "main": "src/_worker.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true,
    "not_found_handling": "none",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "core-spam-filter",
      "database_id": "6903894a-b54a-4183-aa0b-674e3a6e1671",
      "migrations_dir": "./drizzle",
      "remote": true
    },
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "ca4dee69a316422b98395a5b4c87b0a9",
      "remote": true
      
    }
  ],
  // wrangler vectorize create core-spam-filter --preset @cf/baai/bge-large-en-v1.5
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "core-spam-filter",
      "remote": true
    },
  ],
  "ai": {
    "binding": "AI",
      "remote": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SpamAgent",
        "class_name": "SpamAgent",
      },
      {
        "name": "ORCHESTRATOR_AGENT",
        "class_name": "OrchestratorAgent",
      },
      {
        "name": "NOTEBOOKLM_AGENT",
        "class_name": "NotebookLMAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SpamAgent", 
        "ORCHESTRATOR_AGENT", 
        "NOTEBOOKLM_AGENT"
      ],
    },
  ],
  "vars": {
    "AI_GATEWAY_ID": "default-gateway",
    "NOTEBOOKLM_ID": "aa2c184a-a1fe-431f-b62f-5eb8806c9b98", //  https://notebooklm.google.com/notebook/aa2c184a-a1fe-431f-b62f-5eb8806c9b98
    "MODEL_CHAT": "@cf/openai/gpt-oss-120b",
    "MODEL_EXTRACT": "@cf/openai/gpt-oss-120b",
    "MODEL_DRAFT": "@cf/openai/gpt-oss-120b",
    "MODEL_TRANSCRIBE": "@cf/openai/whisper-large-v3-turbo",
    "DEFAULT_MODEL_EMBEDDING": "@cf/baai/bge-large-en-v1.5",
    "BUCKET_NAME_AUDIO": "core-resumes-audio",
    "BUCKET_NAME_FILES": "core-resumes-files",
    "ROLE_PODCAST_POLL_INTERVAL": "5 minutes",
    "ROLE_PODCAST_MAX_POLLS": "36",
    "ROLE_PODCAST_SOURCE_WAIT_SECS": "300",
  },
  "secrets_store_secrets": [
    {
      "binding": "GITHUB_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GH_TOKEN"
    },
    {
      "binding": "CLOUDFLARE_ACCOUNT_ID",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_ACCOUNT_ID"
    },
    {
      "binding": "CLOUDFLARE_WRANGLER_API_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_WRANGLER_API_TOKEN"
    },
    {
      "binding": "CLOUDFLARE_AI_SEARCH_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_AI_SEARCH_TOKEN"
    },
    {
      "binding": "WORKER_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "WORKER_API_KEY"
    },
    {
      "binding": "AGENTIC_WORKER_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "AGENTIC_WORKER_API_KEY"
    },
    {
      "binding": "AI_GATEWAY_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_AI_GATEWAY_TOKEN"
    },
    {
      "binding": "CF_BROWSER_RENDER_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_BROWSER_RENDER_TOKEN"
    },
    {
      "binding": "JULES_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "JULES_API_KEY"
    },
 ]
}
