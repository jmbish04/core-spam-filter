{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "core-spam-filter",
  "main": "src/_worker.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spam-filter-db",
      "database_id": "d126139f-6f57-49d2-bbc4-d20bbd46bbf4",
      "preview_database_id": "d126139f-6f57-49d2-bbc4-d20bbd46bbf4",
      "migrations_dir": "./drizzle",
    },
  ],
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "email-vectors",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SpamAgent",
        "class_name": "SpamAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EmailAnalyzerAgent"],
    },
    {
      "tag": "v2",
      "renamed_classes": [
        {
          "from": "EmailAnalyzerAgent",
          "to": "SpamAgent",
        },
      ],
    },
  ],
  "vars": {
    "AI_GATEWAY_NAME": "core-spam-gateway",
    "DEFAULT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "EMBEDDING_MODEL": "@cf/baai/bge-base-en-v1.5",
  },
  "secrets_store_secrets": [
    {
      "binding": "WORKER_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "WORKER_API_KEY",
    },
  ],
}
